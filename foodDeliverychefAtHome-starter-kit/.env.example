# Copy to .env and fill in. Never commit .env.
# Keep this file in sync whenever a new variable is added.

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=fdc
POSTGRES_PASSWORD=fdc_dev_password
POSTGRES_DB=fdc_dev
DATABASE_URL=postgresql://fdc:fdc_dev_password@localhost:5432/fdc_dev?schema=public
DATABASE_URL_TEST=postgresql://fdc:fdc_test_password@localhost:5433/fdc_test?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
APP_TIMEZONE=Asia/Kolkata

# --- Adapters (fake until providers are chosen: OD-08, BRD §16) ---
PAYMENT_PROVIDER=fake
OTP_PROVIDER=fake
MAPS_PROVIDER=fake
PUSH_PROVIDER=fake
WHATSAPP_PROVIDER=disabled
MASKED_CALLING_PROVIDER=disabled
